    { "id": "live",    "label": "Conference day",           "start": "2026-12-10T00:00:00Z", "end": "2026-12-11T00:00:00Z" },
    { "id": "ratify",  "label": "Outcome ratification",     "start": "2026-12-11T00:00:00Z", "end": "2026-12-13T00:00:00Z" },
